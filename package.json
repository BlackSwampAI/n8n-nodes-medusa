{
	"name": "@blackswampai/n8n-nodes-medusa",
	"version": "0.1.0",
	"description": "n8n community node for the Medusa commerce Admin API, with first-class self-hosted support",
	"license": "MIT",
	"homepage": "https://github.com/BlackSwampAI/n8n-nodes-medusa#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"medusa",
		"medusajs",
		"ecommerce",
		"commerce"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-medusa.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release:check": "node scripts/release-check.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MedusaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Medusa/Medusa.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
