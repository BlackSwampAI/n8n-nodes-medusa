{
	"name": "@blackswampai/n8n-nodes-medusa",
	"version": "0.1.1",
	"packageManager": "npm@11.19.0",
	"description": "n8n community node for the Medusa commerce Admin API, with first-class self-hosted support",
	"license": "MIT",
	"homepage": "https://github.com/BlackSwampAI/n8n-nodes-medusa#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"medusa",
		"medusajs",
		"ecommerce",
		"commerce"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-medusa.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:unit": "vitest run test/unit scripts",
		"test:integration": "vitest run test/integration",
		"test:watch": "vitest",
		"medusa:up": "node scripts/medusa-dev.mjs up",
		"medusa:down": "node scripts/medusa-dev.mjs down",
		"release:check": "node scripts/release-check.mjs",
		"scan:source": "node scripts/scan-source.mjs",
		"scan:published": "node scripts/scan-published.mjs",
		"package:check": "node scripts/package-check.mjs",
		"smoke:load": "node scripts/node-load-smoke.mjs",
		"smoke:install": "node scripts/package-install-smoke.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MedusaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Medusa/Medusa.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.4",
		"@n8n/scan-community-package": "0.34.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.2",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"allowScripts": {
		"eslint-plugin-n8n-nodes-base": false
	}
}
